@@ -0,0 +1,69 @@
+import '../results.css';
+import { render } from 'preact';
+import { invoke } from '@tauri-apps/api/core';
+import { api } from '../api';
+import type { BenchConfig } from './benchConfig';
+import type { ResultSet } from '../contract';
+import { VirtualTable } from '../VirtualTable';
+import { executeQuery } from './stream';
+import { frame } from './index';
+
+const pause = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));
+export async function memoryBench() {
+  const mode = await invoke<string>('viewer_bench_m2', { sessionId: '', action: 'mode', offset: 0 });
+  const report: Record<string, unknown> = { mode, target: 'm2', userAgent: navigator.userAgent };
+  let checkpoint = 0, sessionId = '', profileId = '';
+  const root = document.createElement('div');
+  root.style.cssText = 'position:fixed;inset:0;z-index:10000;display:flex;flex-direction:column;background:var(--surface)';
+  document.body.append(root);
+  const command = <T,>(action: string, offset = 0) => invoke<T>('viewer_bench_m2', { sessionId, action, offset });
+  async function sample(stage: string) {
+    if (stage !== 'prepare-window') { await frame(); await frame(); }
+    Object.assign(report, { checkpoint: ++checkpoint, stage, at: Date.now(), viewport: { width: innerWidth, height: innerHeight, scale: devicePixelRatio }, renderedRows: root.querySelectorAll('.table-row').length, canvasPixels: root.querySelectorAll('canvas').length });
+    await invoke('viewer_bench_write', { report });
+    await invoke('viewer_bench_checkpoint', { checkpoint });
+  }
+  async function query() {
+    if (mode === 'window') return [await command<ResultSet>('open')];
+    const text = `SELECT ${Array.from({ length: 10 }, (_, i) => i % 2 ? `'row ' || i::text AS c${i}` : `9007199254740993::bigint+i AS c${i}`).join(',')} FROM generate_series(1,100000) i`;
+    return executeQuery({ sessionId, runId: crypto.randomUUID(), req: { text, params: {}, row_limit: 100000, graph_node_limit: 300, timeout_ms: 60000, read_only: true } }, () => {});
+  }
+  async function load() {
+    const since = performance.now();
+    const results = await query();
+    if (results.length !== 1 || results[0].row_count !== 100000 || results[0].table?.rows[0][0].t !== 'Int' || results[0].table.rows[0][0].v !== '9007199254740994') throw new Error('Exact query result mismatch');
+    report.queryWall = performance.now() - since;
+    report.uiRows = results[0].table.rows.length;
+    if (mode !== 'headless') render(<VirtualTable table={results[0].table} />, root);
+    // The query-local result is deliberately not kept by this benchmark after rendering.
+  }
+  try {
+    await sample('prepare-window');
+    await sample('startup'); await pause(10000); await sample('idle-10');
+    const drivers = await api('drivers_list', {}), config = await invoke<BenchConfig>('viewer_bench_config');
+    const driver = drivers.find(driver => driver.paradigm === 'Relational' && driver.connection_fields.some(field => field.key === 'host'));
+    if (!driver) throw new Error('No relational test driver');
+    profileId = crypto.randomUUID();
+    await api('profile_save', { profile: { id: profileId, name: 'M2 isolated', driver_id: driver.id, fields: config.table.fields, save_secret: false }, secret: null });
+    sessionId = await api('session_open', { profileId, secret: config.table.secret });
+    await sample('prepare-table'); await load(); await sample('table-100000');
+    if (mode === 'window') {
+      const page = await command<ResultSet>('page', 99800), table = page.table;
+      if (table?.rows.length !== 200 || table.rows[199][0].t !== 'Int' || table.rows[199][0].v !== '9007199254840993') throw new Error('Final page precision mismatch');
+      render(<VirtualTable table={table} />, root); report.finalPageVerified = true;
+      await sample('last-page');
+    }
+    const closedAt = performance.now(); render(null, root); await command('release');
+    await sample('tabs-closed'); await pause(Math.max(0, closedAt + 10000 - performance.now())); await sample('tabs-closed-10');
+    await pause(Math.max(0, closedAt + 30000 - performance.now())); await sample('tabs-closed-30');
+    await command('cache'); await pause(3000); await sample('cache-requested-3');
+    await sample('pressure-ready'); await sample('pressure-after');
+    report.complete = true;
+  } catch (error) { report.complete = false; report.error = error instanceof Error ? error.message : String(error); }
+  finally {
+    render(null, root); root.remove(); await command('release').catch(() => {});
+    if (sessionId) await api('session_close', { sessionId });
+    if (profileId) await api('profile_delete', { profileId });
+    await invoke('viewer_bench_write', { report });
+  }
+}
diff --git a/ui/src/perf/m2References.ts b/ui/src/perf/m2References.ts
new file mode 100644
index 0000000..c1deadc
--- /dev/null
+++ b/ui/src/perf/m2References.ts
@@ -0,0 +1,20 @@
+// Diagnostic only: inspect data properties, never invoke getters or expand large result arrays.
+export function referencePaths(roots: object[], targets: Set<object>, limit = 20000) {
+  const queue = roots.map((value, index) => ({ value, path: `root${index}`, depth: 0 }));
+  const seen = new WeakSet<object>(), paths: string[] = [];
+  let index = 0;
+  while (index < queue.length && index < limit) {
+    const { value, path, depth } = queue[index++];
+    if (seen.has(value)) continue;
+    seen.add(value);
+    if (targets.has(value)) { paths.push(path); continue; }
+    if (depth >= 24 || ArrayBuffer.isView(value) || value instanceof ArrayBuffer || (Array.isArray(value) && value.length > 1000)) continue;
+    const entries: [string, unknown][] = value instanceof Map || value instanceof Set ? [...value.values()].slice(0, 1000).map((item, index) => [`entry${index}`, item]) : Object.entries(Object.getOwnPropertyDescriptors(value)).map(([key, descriptor]) => [key, descriptor.value]);
+    for (const [key, child] of entries) {
+      if (typeof child !== 'object' || child === null || seen.has(child)) continue;
+      if (queue.length >= limit) break;
+      queue.push({ value: child, path: `${path}.${key}`, depth: depth + 1 });
+    }
+  }
+  return { paths, visited: seen, examined: index, truncated: index >= limit };
+}
