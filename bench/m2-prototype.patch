diff --git a/src-tauri/src/viewer_bench_m2.rs b/src-tauri/src/viewer_bench_m2.rs
new file mode 100644
index 0000000..40666df
--- /dev/null
+++ b/src-tauri/src/viewer_bench_m2.rs
@@ -0,0 +1,58 @@
+//! Bounded, fixed-query experiment; not a product result-handle API.
+use crate::{storage::HistorySource, CommandResult, Host};
+use dbcore::{DbError, ExecRequest, ResultSet, Table};
+use std::sync::Mutex;
+use tauri::Manager;
+
+static RESULT: Mutex<Option<(String, ResultSet)>> = Mutex::new(None);
+
+pub fn query() -> String {
+    format!("SELECT {} FROM generate_series(1,100000) i", (0..10).map(|i| if i % 2 == 1 { format!("'row ' || i::text AS c{i}") } else { format!("9007199254740993::bigint+i AS c{i}") }).collect::<Vec<_>>().join(","))
+}
+
+fn page(result: &ResultSet, offset: usize) -> Result<ResultSet, DbError> {
+    let table = result.table.as_ref().ok_or_else(|| DbError::internal("Expected benchmark table"))?;
+    if offset > table.rows.len() { return Err(DbError::query("Page offset exceeds result")); }
+    let mut output = ResultSet { title: result.title.clone(), row_count: result.row_count, truncated: result.truncated, elapsed_ms: result.elapsed_ms, ..Default::default() };
+    output.table = Some(Table { columns: table.columns.clone(), rows: table.rows[offset..table.rows.len().min(offset.saturating_add(200))].to_vec() });
+    Ok(output)
+}
+
+#[tauri::command]
+pub async fn viewer_bench_m2(host: tauri::State<'_, Host>, window: tauri::WebviewWindow, session_id: String, action: String, offset: usize) -> CommandResult<serde_json::Value> {
+    if !super::viewer_bench::viewer_bench_enabled() || window.app_handle().config().identifier != "dev.axdb.m2probe" { return Err(DbError::unsupported(format!("Isolated M2 benchmark disabled: {}", window.app_handle().config().identifier))); }
+    match action.as_str() {
+        "mode" => Ok(serde_json::json!(std::env::var("AXDB_M2_MODE").unwrap_or_else(|_| "raw".into()))),
+        "cache" => { window.clear_all_browsing_data().map_err(|_| DbError::internal("Cannot clear webview data"))?; Ok(serde_json::Value::Null) },
+        "open" => {
+            let mut results = crate::execute_impl(&host, session_id.clone(), uuid::Uuid::new_v4().to_string(), ExecRequest { text: query(), params: Default::default(), row_limit: 100000, graph_node_limit: 300, timeout_ms: 60000, read_only: true, preview_sample_limit: 50 }, None, HistorySource::Ui).await?;
+            if results.len() != 1 || results[0].row_count != 100000 { return Err(DbError::internal("Unexpected benchmark result")); }
+            let result = results.remove(0);
+            let output = page(&result, 0)?;
+            *RESULT.lock().map_err(|_| DbError::internal("Benchmark result lock"))? = Some((session_id, result));
+            serde_json::to_value(output).map_err(|_| DbError::internal("Cannot encode benchmark page"))
+        },
+        "page" => {
+            let guard = RESULT.lock().map_err(|_| DbError::internal("Benchmark result lock"))?;
+            let (owner, result) = guard.as_ref().ok_or_else(|| DbError::query("Benchmark result released"))?;
+            if owner != &session_id { return Err(DbError::query("Benchmark session mismatch")); }
+            serde_json::to_value(page(result, offset)?).map_err(|_| DbError::internal("Cannot encode benchmark page"))
+        },
+        "release" => { RESULT.lock().map_err(|_| DbError::internal("Benchmark result lock"))?.take(); Ok(serde_json::Value::Null) },
+        _ => Err(DbError::unsupported("Unknown benchmark action")),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn fixed_query_and_window_bounds() {
+        assert!(query().contains("9007199254740993::bigint+i AS c8"));
+        let result = ResultSet { table: Some(Table { columns: vec![], rows: vec![vec![]; 451] }), ..Default::default() };
+        assert_eq!(page(&result, 0).unwrap().table.unwrap().rows.len(), 200);
+        assert_eq!(page(&result, 400).unwrap().table.unwrap().rows.len(), 51);
+        assert!(page(&result, usize::MAX).is_err());
+        assert_eq!(page(&result, 451).unwrap().table.unwrap().rows.len(), 0);
+    }
+}
