@@ -0,0 +1,10 @@
+import { expect, it } from 'vitest';
+import { referencePaths } from './m2References';
+it('finds data-property and Map roots without invoking getters or walking large row arrays', () => {
+  const target = {}, root: Record<string, unknown> = { map: new Map([['private', target]]), rows: Array(100001).fill(target) };
+  root.self = root;
+  Object.defineProperty(root, 'unsafe', { enumerable: true, get() { throw new Error('Getter invoked'); } });
+  const result = referencePaths([root], new Set([target]));
+  expect(result.paths).toEqual(['root0.map.entry0']);
+  expect(result.truncated).toBe(false);
+});
