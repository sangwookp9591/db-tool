+//! Measurement only: this module is never linked into the product.
+use crate::{viewer_bench, CommandResult, DbError, Host};
+use serde_json::{json, Value};
+use std::sync::Mutex;
+use tauri::Manager;
+static SNAPSHOT: Mutex<Option<Value>> = Mutex::new(None);
+fn enabled(app: &tauri::AppHandle) -> CommandResult<()> {
+    if (viewer_bench::viewer_bench_enabled() || std::env::var("AXDB_M5_E2E").as_deref()==Ok("1")) && app.config().identifier == "dev.axdb.m5probe" { Ok(()) }
+    else { Err(DbError::unsupported("Isolated M4 probe only")) }
+}
+#[tauri::command]
+pub async fn m4_probe(app: tauri::AppHandle, action: String, value: Option<Value>) -> CommandResult<Value> {
+    enabled(&app)?;
+    match action.as_str() {
+        "pause" => {
+            let since = std::time::Instant::now();
+            let path = app.state::<Host>().paths.config.join("m5-timer.json");
+            tokio::time::sleep(std::time::Duration::from_secs(10)).await;
+            let host_ms = since.elapsed().as_secs_f64()*1000.;
+            let completed = epoch();
+            crate::storage::write_private(&path, &serde_json::to_vec(&json!({"host_ms":host_ms,"completed_at":completed})).unwrap())?;
+            let wake = app.clone();
+            tauri::async_runtime::spawn(async move {
+                tokio::time::sleep(std::time::Duration::from_secs(2)).await;
+                let at = epoch();
+                let window = wake.get_window("main").unwrap();
+                let _ = wake.show(); let _ = window.show(); let _ = window.set_focus();
+                if let Some(webview) = wake.get_webview("main") { let _ = webview.set_focus(); }
+                let _ = crate::storage::write_private(&wake.state::<Host>().paths.config.join("m5-activation-request.json"), &serde_json::to_vec(&json!({"at":at})).unwrap());
+            });
+            Ok(json!({"host_ms":host_ms,"completed_at":completed}))
+        },
+        "get" => Ok(SNAPSHOT.lock().unwrap().clone().unwrap_or(Value::Null)),
+        "quick" => Ok(json!(std::env::var("AXDB_M5_QUICK").as_deref()==Ok("1"))),
+        "mode" => Ok(json!(std::env::var("AXDB_M4_MODE").unwrap_or_else(|_| "control".into()))),
+        "activation" => Ok(serde_json::from_slice(&std::fs::read(app.state::<Host>().paths.config.join("m5-activation.json")).map_err(|_|DbError::internal("No activation"))?).unwrap()),
+        "activate" => {
+            let window = app.get_window("main").ok_or_else(|| DbError::internal("No main window"))?;
+            let since = std::time::Instant::now();
+            window.show().map_err(|_| DbError::internal("Cannot show probe"))?;
+            window.set_focus().map_err(|_| DbError::internal("Cannot focus probe"))?;
+            Ok(json!({"native_ms":since.elapsed().as_secs_f64()*1000.0}))
+        }
+        "arm" => {
+            let state = value.ok_or_else(|| DbError::query("Snapshot required"))?;
+            if state["ui"]["tabs"].as_array().is_none_or(|tabs| tabs.iter().any(|tab| tab["kind"]!="query" || tab["runId"]!=Value::Null || tab["dirty"]==true)) || !app.state::<Host>().runs.lock().unwrap().is_empty() {
+                return Err(DbError::query("Probe still has tabs or running operations"));
+            }
+            *SNAPSHOT.lock().unwrap() = Some(state);
+            app.get_window("main").unwrap().hide().map_err(|_| DbError::internal("Cannot hide probe"))?;
+            if std::env::var("AXDB_M5_PRODUCT").as_deref()==Ok("1") && std::env::var("AXDB_M4_MODE").as_deref()==Ok("replace") { return Ok(Value::Null); }
+            tauri::async_runtime::spawn(async move {
+                tokio::time::sleep(std::time::Duration::from_secs(if std::env::var("AXDB_M5_QUICK").as_deref()==Ok("1"){2}else{120})).await;
+                if std::env::var("AXDB_M5_PRODUCT").as_deref()!=Ok("1") { activity(); }
+                let result = recycle(&app);
+                if let Err(error) = result { let _ = crate::storage::write_private(&app.state::<Host>().paths.config.join("m4-error.json"), &serde_json::to_vec(&error).unwrap()); }
+            });
+            Ok(Value::Null)
+        }
+        _ => Err(DbError::query("Unknown probe action")),
+    }
+}
+fn recycle(app: &tauri::AppHandle) -> CommandResult<()> {
+    let window = app.get_window("main").ok_or_else(|| DbError::internal("No main window"))?;
+    if window.is_visible().unwrap_or(true) || window.is_focused().unwrap_or(true) || !app.state::<Host>().runs.lock().unwrap().is_empty() {
+        return Err(DbError::query("Probe became active or busy; recycle aborted"));
+    }
+    let mode = std::env::var("AXDB_M4_MODE").unwrap_or_default();
+    let started = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis();
+    SNAPSHOT.lock().unwrap().as_mut().unwrap()["recycle_at"] = json!(started);
+    if mode == "control" { return Ok(()); }
+    app.state::<crate::agent_bridge::Bridge>().loading(&app.state::<Host>().paths.config);
+    if mode == "reload" {
+        app.get_webview_window("main").ok_or_else(|| DbError::internal("No main webview window"))?.reload().map_err(|_| DbError::internal("Reload failed"))?;
+    } else if mode == "replace" {
+        app.get_webview("main").ok_or_else(|| DbError::internal("No main webview"))?.close().map_err(|_| DbError::internal("Close failed"))?;
+        let config = app.config().app.windows[0].clone();
+        let builder = tauri::webview::WebviewBuilder::from_config(&config);
+        let size = window.inner_size().map_err(|_| DbError::internal("No window size"))?;
+        window.add_child(builder, tauri::PhysicalPosition::new(0, 0), size).map_err(|_| DbError::internal("Replacement failed"))?;
+    } else { return Err(DbError::query("Invalid M4 mode")); }
+    Ok(())
+}
+
+fn epoch() -> u128 { std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis() }
+fn activity() {
+    if std::env::var("AXDB_M5_ACTIVITY").as_deref() != Ok("1") { return; }
+    let (ready, start) = std::sync::mpsc::sync_channel(0);
+    std::thread::spawn(move || {
+        use objc2_foundation::{NSActivityOptions, NSProcessInfo, NSString};
+        let info = NSProcessInfo::processInfo();
+        let token = info.beginActivityWithOptions_reason(NSActivityOptions::UserInitiatedAllowingIdleSystemSleep, &NSString::from_str("Prepare idle workspace"));
+        let _ = ready.send(());
+        std::thread::sleep(std::time::Duration::from_secs(15));
+        unsafe { info.endActivity(&token); }
+    });
+    let _ = start.recv();
+}
+
+pub(crate) fn focused(app: &tauri::AppHandle) {
+    if SNAPSHOT.lock().unwrap().is_some() {
+        let _ = crate::storage::write_private(&app.state::<Host>().paths.config.join("m5-activation.json"), &serde_json::to_vec(&json!({"at":epoch()})).unwrap());
+        if let Some(webview) = app.get_webview("main") { let _ = webview.set_focus(); }
+    }
+}
+
+pub(crate) fn stamp() { if let Some(saved)=SNAPSHOT.lock().unwrap().as_mut() {saved["recycle_at"]=json!(epoch());} }
