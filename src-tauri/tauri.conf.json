{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "db-tool",
  "version": "0.1.0",
  "identifier": "dev.dbtool.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": { "windows": [{ "title": "db-tool", "width": 1280, "height": 800 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": "all" }
}
